    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #eef7ff;
            color: #35566f;
            line-height: 1.7;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 18px 8%;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(100,160,200,0.15);
        }

        nav h2 {
            color: #6b9fc1;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            text-decoration: none;
            color: #50758d;
            font-weight: bold;
        }

        nav a:hover {
            color: #82b9dc;
        }

        /* GENERAL */
        section {
            padding: 100px 10%;
        }

        /* HOME */
        #home {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(135deg, #e8f6ff, #d8efff);
        }

        .profile {
            max-width: 700px;
        }

        .profile img {
            width: 170px;
            height: 170px;
            object-fit: cover;
            border-radius: 50%;
            border: 7px solid white;
            box-shadow: 0 10px 30px rgba(80,140,180,0.2);
            margin-bottom: 20px;
        }

        .profile h1 {
            font-size: 45px;
            color: #477b9c;
            margin-bottom: 10px;
        }

        .profile p {
            font-size: 18px;
            color: #66899f;
        }

        .button {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 28px;
            border-radius: 30px;
            background: #8fc5e5;
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        .button:hover {
            background: #6daed3;
            transform: translateY(-3px);
        }

        /* TITLE */
        .title {
            text-align: center;
            color: #477b9c;
            font-size: 32px;
            margin-bottom: 40px;
        }

        /* ABOUT */
        .about {
            display: flex;
            gap: 40px;
            align-items: center;
        }

        .about-text {
            flex: 1;
            background: white;
            padding: 30px;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(90,150,190,0.1);
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 22px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(90,150,190,0.12);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
        }

        .card h3 {
            color: #639abd;
            margin-bottom: 10px;
        }

        /* SKILLS */
        .skill {
            margin-bottom: 20px;
        }

        .skill-name {
            margin-bottom: 5px;
        }

        .bar {
            height: 12px;
            background: #d9edf8;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress {
            height: 100%;
            background: #91c7e4;
            border-radius: 20px;
        }

        /* CONTACT */
        .contact {
            text-align: center;
        }

        .contact p {
            margin: 10px;
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 25px;
            background: #d9effc;
            color: #55788e;
        }

        /* MOBILE */
        @media(max-width: 700px) {

            nav {
                padding: 15px 5%;
            }

            nav ul {
                gap: 10px;
                font-size: 12px;
            }

            .profile h1 {
                font-size: 34px;
            }

            .about {
                flex-direction: column;
            }

            section {
                padding: 80px 6%;
            }
        }
    </style>
</head>

